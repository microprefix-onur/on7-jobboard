# Postgres connection used by the app and drizzle-kit.
DATABASE_URL="postgres://jobboard:jobboard@localhost:5432/jobboard"

# Optional: database the integration tests recreate and migrate on every run.
# TEST_DATABASE_URL="postgres://jobboard:jobboard@localhost:5432/jobboard_test"

# Public URL of the app; used by better-auth and adapter-node. Docker Compose uses http://localhost:3000.
ORIGIN="http://localhost:5173"

# Secret used by better-auth to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
